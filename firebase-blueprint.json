{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "User profiles including role and auth info",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Auth UID" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "avatar": { "type": "string", "description": "URL to profile picture" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "provider": { "type": "string", "enum": ["google", "facebook", "admin"] },
        "joinedDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "whatsapp": { "type": "string", "description": "Optional WhatsApp number" }
      },
      "required": ["id", "name", "email", "role", "status"]
    },
    "apps": {
      "title": "Applications",
      "description": "App store items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "titleFr": { "type": "string" },
        "category": { "type": "string" },
        "downloadsCount": { "type": "integer" },
        "rating": { "type": "number" },
        "status": { "type": "string", "enum": ["published", "draft", "pending"] },
        "pinnedExpiry": { "type": "number", "description": "Timestamp" }
      },
      "required": ["title", "category", "status"]
    },
    "categories": {
      "title": "Categories",
      "description": "App categories",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nameAr": { "type": "string" },
        "nameFr": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" }
      },
      "required": ["id", "nameAr", "nameFr"]
    },
    "siteSettings": {
      "title": "Site Settings",
      "description": "Global configuration",
      "type": "object",
      "properties": {
        "whatsappNumber": { "type": "string" },
        "siteTitleAr": { "type": "string" },
        "siteTitleFr": { "type": "string" }
      }
    },
    "projectRequests": {
      "title": "Project Consultation Requests",
      "description": "Software & web development consultation requests generated by AI Assistant for administration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectType": { "type": "string" },
        "projectTitle": { "type": "string" },
        "userIdea": { "type": "string" },
        "aiSummary": { "type": "string" },
        "suggestedTech": { "type": "string" },
        "estimatedTimeline": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userPhone": { "type": "string" },
        "userId": { "type": "string" },
        "ipAddress": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "contacted", "in_development", "completed"] }
      },
      "required": ["projectType", "userIdea", "aiSummary", "userName", "status"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "users",
      "description": "Individual user profiles"
    },
    "apps/{appId}": {
      "schema": "apps",
      "description": "Application entries"
    },
    "categories/{categoryId}": {
      "schema": "categories",
      "description": "Categories list"
    },
    "settings/global": {
      "schema": "siteSettings",
      "description": "Global site settings"
    },
    "projectRequests/{requestId}": {
      "schema": "projectRequests",
      "description": "Development project requests and messages to admin"
    }
  }
}
