{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "User profiles including role and auth info",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Auth UID" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "avatar": { "type": "string", "description": "URL to profile picture" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "provider": { "type": "string", "enum": ["google", "facebook", "admin"] },
        "joinedDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "whatsapp": { "type": "string", "description": "Optional WhatsApp number" }
      },
      "required": ["id", "name", "email", "role", "status"]
    },
    "apps": {
      "title": "Applications",
      "description": "App store items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "titleFr": { "type": "string" },
        "category": { "type": "string" },
        "downloadsCount": { "type": "integer" },
        "rating": { "type": "number" },
        "status": { "type": "string", "enum": ["published", "draft", "pending"] },
        "pinnedExpiry": { "type": "number", "description": "Timestamp" }
      },
      "required": ["title", "category", "status"]
    },
    "categories": {
      "title": "Categories",
      "description": "App categories",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nameAr": { "type": "string" },
        "nameFr": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" }
      },
      "required": ["id", "nameAr", "nameFr"]
    },
    "siteSettings": {
      "title": "Site Settings",
      "description": "Global configuration",
      "type": "object",
      "properties": {
        "whatsappNumber": { "type": "string" },
        "siteTitleAr": { "type": "string" },
        "siteTitleFr": { "type": "string" }
      }
    },
    "projectRequests": {
      "title": "Project Consultation Requests",
      "description": "Software & web development consultation requests generated by AI Assistant for administration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectType": { "type": "string" },
        "projectTitle": { "type": "string" },
        "userIdea": { "type": "string" },
        "aiSummary": { "type": "string" },
        "suggestedTech": { "type": "string" },
        "estimatedTimeline": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userPhone": { "type": "string" },
        "userId": { "type": "string" },
        "ipAddress": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "contacted", "in_development", "completed"] }
      },
      "required": ["projectType", "userIdea", "aiSummary", "userName", "status"]
    },
    "notifications": {
      "title": "News Notifications",
      "description": "Persistent site-wide news and updates for members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titleAr": { "type": "string" },
        "titleFr": { "type": "string" },
        "messageAr": { "type": "string" },
        "messageFr": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "update", "news", "alert"] },
        "createdAt": { "type": "string" },
        "targetAppId": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["titleAr", "messageAr", "type", "createdAt", "isActive"]
    },
    "reviews": {
      "title": "App Reviews",
      "description": "User ratings and comments for applications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "appId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["appId", "userId", "userName", "rating", "createdAt"]
    },
    "chats": {
      "title": "Member Chat Messages",
      "description": "Real-time messages between members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "receiverId": { "type": "string" },
        "text": { "type": "string", "maxLength": 2000 },
        "timestamp": { "type": "string" },
        "isRead": { "type": "boolean" }
      },
      "required": ["senderId", "receiverId", "text", "timestamp", "isRead"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "users",
      "description": "Individual user profiles"
    },
    "apps/{appId}": {
      "schema": "apps",
      "description": "Application entries"
    },
    "categories/{categoryId}": {
      "schema": "categories",
      "description": "Categories list"
    },
    "settings/global": {
      "schema": "siteSettings",
      "description": "Global site settings"
    },
    "projectRequests/{requestId}": {
      "schema": "projectRequests",
      "description": "Development project requests and messages to admin"
    },
    "notifications/{notifId}": {
      "schema": "notifications",
      "description": "News and update notifications"
    },
    "reviews/{reviewId}": {
      "schema": "reviews",
      "description": "Individual app ratings and reviews"
    },
    "chats/{chatId}": {
      "schema": "chats",
      "description": "Peer-to-peer chat messages"
    }
  }
}
